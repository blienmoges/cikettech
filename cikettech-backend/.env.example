PORT=4000
JWT_SECRET=replace-with-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000

# AI Assistant (optional). Without this set, the assistant falls back to a
# keyword search over the knowledge base instead of calling Gemini.
# Get a free key at https://aistudio.google.com/apikey (no credit card required).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
